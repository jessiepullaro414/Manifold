# KiCad/editor working files and intermediate autorouter exports -
# regenerated by build_schematic.py/build_pcb.py/route_board.py, not
# hand-authored source. Same convention as the sibling ecu-pcb project.
*.dsn
*.ses
*.lck
.history/
__pycache__/
*.pyc
fp-info-cache
*.kicad_pcb-bak
*.kicad_sch-bak

# Third-party tool binary (FreeRouting, ~57MB), not project-specific
# code - see README for the real download requirement instead of
# committing a large third-party jar.
tools/*.jar

# Fab-output artifacts - regenerated on demand via kicad-cli from
# Manifold.kicad_pcb, not hand-authored source, and they go stale the
# moment the board changes.
fab_output/
Manifold_gerbers.zip
manifold_fab_check.png

# generic
.DS_Store
Thumbs.db
